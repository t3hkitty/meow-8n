{
  "name": "n8n-android-local",
  "version": "1.0.0",
  "description": "Local-only n8n Android host controller and web companion with localhost support, Termux/Shizuku automation, and local SSL handling.",
  "main": "www/index.html",
  "scripts": {
    "build": "npm run copy",
    "copy": "npx cap copy",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "build:android": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew assembleRelease"
  },
  "keywords": [
    "n8n",
    "android",
    "termux",
    "shizuku",
    "localhost",
    "capacitor",
    "automation",
    "local-ssl"
  ],
  "author": "Laura Flores",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/toast": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
